    <script>try{var e=localStorage.getItem("@cld/unicorn/theme-cache");if(e){var t=JSON.parse(e);t&&t.paletteBackground&&document.body.style.setProperty("--unicorn-cached-palette-background",t.paletteBackground)}}catch{}</script>
    <div id="root">
      <style>
        @keyframes dashKeyframes {
          0% {
            stroke-dashoffset: 560;
          }

          50% {
            stroke-dashoffset: 0;
          }

          100% {
            stroke-dashoffset: 560;
          }
        }

        html,
        body {
          margin: 0;
          padding: 0;
        }

        .initial-spinner__wrapper {
          background-color: var(--unicorn-cached-palette-background, #f3f4f7);
          position: fixed;
          display: flex;
          align-items: center;
          justify-content: center;
          flex: 1;
          height: 100vh;
          width: 100vw;
        }

        svg.initial-spinner {
          max-width: 128px;
        }

        svg.initial-spinner path {
          stroke-dasharray: 280;
          stroke-dashoffset: 0;
          transform-origin: center;
          stroke: #3448c5;
          animation: dashKeyframes 2s ease-in-out infinite;
        }
      </style>
      <div class="initial-spinner__wrapper">
        <svg class="initial-spinner" viewBox="-4 -4 151 100" preserveaspectaatio="xMidYMid">
